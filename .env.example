# Copy this file to .env and fill in real values. Never commit .env.
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
MATTERPORT_SDK_KEY=
VEXCEL_API_KEY=
ANTHROPIC_API_KEY=

# Path to the unzipped CoStar hackathon kit on your machine.
COSTAR_KIT_PATH=/Users/you/Downloads/costar-hackathon-kit

# Optional - Oasis web app
CENSUS_API_KEY=
# OASIS_MODEL=claude-opus-5-5
# Optional Gmail OAuth for the local quote demo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional Gmail SMTP app password for the profile Gmail account.
GMAIL_APP_PASSWORD=
# Enable live Gmail sending to real contractor addresses.
# OASIS_SEND_EMAIL=1

# Optional imagery modes. Use a Google browser Demo Key and a Vexcel imagery-enabled key.
GOOGLE_MAPS_DEMO_KEY=
VEXCEL_IMAGERY_API_KEY=
