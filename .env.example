# Copy this file to .env and fill in real values. Never commit .env.
VEXCEL_API_KEY=
ANTHROPIC_API_KEY=

# Path to the unzipped CoStar hackathon kit on your machine.
COSTAR_KIT_PATH=/Users/you/Downloads/costar-hackathon-kit

# Optional - Oasis web app
CENSUS_API_KEY=
# OASIS_MODEL=claude-opus-5-5
# Optional Gmail OAuth for the local quote demo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional Gmail SMTP app password and sender address for the profile Gmail account.
GMAIL_APP_PASSWORD=
GMAIL_SENDER_EMAIL=
# Enable live Gmail sending to real contractor addresses.
# OASIS_SEND_EMAIL=1
# Add one real address here to test the actual send/reply loop locally -
# never commit a real value, these stay blank in version control.
TEST_CONTRACTOR_FIRST_NAME=
TEST_CONTRACTOR_LAST_NAME=
TEST_CONTRACTOR_EMAIL=

# Optional imagery modes. GOOGLE_MAPS_DEMO_KEY is a Google Maps browser key.
# VEXCEL_IMAGERY_API_KEY is only needed if VEXCEL_API_KEY above isn't itself
# imagery-enabled - the webapp accepts either one for imagery mode.
GOOGLE_MAPS_DEMO_KEY=
VEXCEL_IMAGERY_API_KEY=
